{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node", "@webgpu/types"],
    "lib": ["es2023", "dom", "dom.iterable"]
  },
  "include": ["build.ts", "gallery.ts", "strip.ts", "tests"]
}
